# Copy to .env and fill in. `docker compose` / `make` picks up .env automatically.

# --- image tag (all profiles) ---
# Tracks GitStore's newest build pre-GA; after the first stable release it stops
# moving on prereleases, so pin a version once you depend on this for anything
# beyond a quick local test.
GITSTORE_TAG=latest

# --- local profile bootstrap admin (used once, by serviceaccount-enrollment) ---
# GITSTORE_BOOTSTRAP_ADMIN_USERNAME=admin
# GITSTORE_BOOTSTRAP_ADMIN_PASSWORD=admin123

# --- scylla cluster profile (PROFILE=cluster): optional, shown with their defaults ---
# Chosen so 3 nodes fit under Docker Desktop's typical fs.aio-max-nr without host tuning.
# Lower SCYLLA_CLUSTER_MAX_NETWORKING_IO_CONTROL_BLOCKS further if you still hit an AIO
# error (see README Troubleshooting).
# SCYLLA_CLUSTER_SMP=1
# SCYLLA_CLUSTER_MAX_NETWORKING_IO_CONTROL_BLOCKS=2048

# --- host port overrides (all optional, shown with their defaults) ---
# GITSTORE_HOST_API_GRAPHQL_PORT=4000
# GITSTORE_HOST_API_GIT_PORT=9000
# GITSTORE_HOST_SCYLLA_PORT=9042
# GITSTORE_HOST_OIDC_ISSUER_PORT=4444
# GITSTORE_HOST_OIDC_BRIDGE_PORT=4445
# GITSTORE_HOST_KRATOS_PUBLIC_PORT=4433
# GITSTORE_HOST_KRATOS_UI_PORT=4455
# GITSTORE_HOST_MAILSLURPER_PORT=4436

# --- oidc profile: required, no defaults, 32+ chars each ---
# Generate with: openssl rand -hex 32
# (hex, not base64 - HYDRA_DB_PASSWORD/KRATOS_DB_PASSWORD get embedded directly in an
# unencoded postgres:// DSN, and base64's "/" or "+" breaks that URL's parsing)
HYDRA_DB_PASSWORD=
HYDRA_SECRETS_SYSTEM=
HYDRA_SECRETS_COOKIE=
GITSTORE_OIDC_CLIENT_SECRET=
KRATOS_DB_PASSWORD=
KRATOS_SECRETS_COOKIE=
KRATOS_SECRETS_DEFAULT=
KRATOS_UI_COOKIE_SECRET=
KRATOS_UI_CSRF_SECRET=

# --- oidc profile: optional overrides ---
# GITSTORE_OIDC_CLIENT_ID=gitstore
# GITSTORE_OIDC_CLIENT_AUDIENCE=gitstore
# GITSTORE_OIDC_REDIRECT_URIS=http://localhost:3000/callback

# oidc-bridge ships from GitStore's optional-images pipeline, which hasn't cut a
# versioned/latest tag yet - only main/main-<sha> exist so far. Override once it has.
# GITSTORE_OIDC_BRIDGE_TAG=main
